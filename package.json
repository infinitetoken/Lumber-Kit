{
  "name": "@infinitetoken/lumber-kit",
  "version": "0.7.0",
  "description": "Shared TypeScript types and wire format contracts for the Lumber cloud logging suite",
  "keywords": [
    "lumber",
    "logging",
    "cloud-logging",
    "typescript",
    "types",
    "wire-format",
    "contracts",
    "schema",
    "log-schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitetoken/lumber-kit.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./contract/*": "./contract/*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contract"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "contract": "node scripts/contract.cjs",
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.2.1",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.2.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@infinitetoken/lumber-kit",
  "version": "0.4.20",
  "description": "Shared TypeScript types and wire format contracts for the Lumber cloud logging suite",
  "keywords": [
    "lumber",
    "logging",
    "cloud-logging",
    "typescript",
    "types",
    "wire-format",
    "contracts",
    "schema",
    "log-schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitetoken/lumber-kit.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^1.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
